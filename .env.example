# Copiez ce fichier en « .env » à la racine du projet et renseignez vos propres valeurs.
# Ne commitez jamais le fichier .env.

# Base PostgreSQL locale (lancée avec : docker compose up -d)
DATABASE_URL=postgres://forum:forum@localhost:5432/forum?sslmode=disable

# Clé de signature des JWT : longue et aléatoire (ex : openssl rand -base64 32)
JWT_SECRET=a-remplacer

# URL de l'API utilisée par le client
API_BASE_URL=http://localhost:8080/api
